rules_version = '2';
// Firestore rules for the GitHub Pages copy of Commits Against Humanity.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // A device can edit the account it owns or the account selected with a personal code.
    function linkedTo(uid) {
      let link = /databases/$(database)/documents/accountLinks/$(request.auth.uid);
      return exists(link) && get(link).data.accountId == uid;
    }

    // Codes are 120 random bits, never public profile fields or listable collections.
    match /accountKeys/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{24}$')
        && request.resource.data.keys().hasOnly(['accountId'])
        && request.resource.data.accountId == request.auth.uid;
      allow update, delete: if false;
    }
    match /accountLinks/{device} {
      allow get: if signedIn() && request.auth.uid == device;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == device
        && request.resource.data.keys().hasOnly(['accountId', 'code'])
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-HJ-NP-Z2-9]{24}$')
        && getAfter(/databases/$(database)/documents/accountKeys/$(request.resource.data.code)).data.accountId == request.resource.data.accountId;
      allow delete: if signedIn() && request.auth.uid == device;
    }

    // Rulers: everyone reads the standings; access codes remain in private records.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if signedIn() && (request.auth.uid == uid || linkedTo(uid));
    }

    // Lobbies: the host's browser writes the lobby, each player writes their own seat
    // (the host may also remove seats), so any signed-in browser may write here.
    match /lobbies/{code} {
      allow read: if signedIn();
      allow write: if signedIn() && code.matches('^[A-Z]{4}$');
      match /players/{pid} {
        allow read: if signedIn();
        allow write: if signedIn() && pid.matches('^p[a-z0-9]{12}$');
      }
      // The game's draw and discard piles, kept out of the lobby document so players don't download them on every change.
      match /deck/{doc} {
        allow read: if signedIn();
        allow write: if signedIn() && doc == 'piles';
      }
    }

    // Open-lobby list shown on the home screen.
    match /directory/{code} {
      allow read: if signedIn();
      allow write: if signedIn() && code.matches('^[A-Z]{4}$');
    }

    // Card packs written by players.
    match /packs/{id} {
      allow read: if signedIn();
      allow write: if signedIn() && id.matches('^k[a-z0-9]{10}$');
    }
  }
}
